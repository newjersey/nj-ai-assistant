# Environment variables specific to Prod.
#
# Note: DO NOT PUT SECRETS IN THIS FILE! Secrets are handled in the render-env
# script and GitHub environments along with nj.env.template, and shared
# constant values just live in the nj.env.template.DEBUG=false
CONFIG_PATH=nj/librechat-config/librechat.prod.yaml
ALLOW_SOCIAL_LOGIN=true
ALLOW_EMAIL_LOGIN=false
ALLOW_PASSWORD_RESET=false
MEILI_HOST=http://meilisearch.internal:7700
NJ_FF_MEMORY_ENABLED=false
SEARCH=false
