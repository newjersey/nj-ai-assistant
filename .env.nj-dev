# Environment variables specific to Dev.
#
# Secrets are handled in the render-env script, shared constants are in the nj.env.template.
DEBUG=true
CONFIG_PATH=nj/nj-librechat.yaml
ALLOW_SOCIAL_LOGIN=true
ALLOW_EMAIL_LOGIN=false
ALLOW_PASSWORD_RESET=false
MEILI_HOST=http://meilisearch.internal:7700
NJ_FF_MEMORY_ENABLED=true
SEARCH=true
