###############################################################################
# New Jersey LibreChat Config File
#
# Used in conjunction w/ the .env file from BitWarden (because part of
# LibreChat's config still lives in .env, as well as secret API keys).
###############################################################################

# Configuration version (required)
version: 1.3.6

# Cache settings: Set to true to enable caching
cache: true

# We use S3 when deployed, but for local dev, recommend setting `FILE_STRATEGY=local` in .env
fileStrategy: 's3'

# Custom interface configuration
interface:
  customWelcome: 'NJ AI Assistant'

  # Disable temporary chats (we need to retain data for OPRA)
  temporaryChat: false

  # We allow model selection in general, but set `showInMenu: false` to hide a model-spec
  modelSelect: true

  # We're purposefully disabling most LibreChat features (for now)
  agents:
    use: true
    create: true
    share: false # in addition to hiding the copy link, we are setting share to false
    public: true
  bookmarks: false
  endpointsMenu: false
  fileCitations: false
  fileSearch: true
  marketplace:
    use: true
{% if NJ_FF_MEMORY_ENABLED === "true" %}
  memories: true
{% else %}
  memories: false
{% endif %}
  multiConvo: false
  parameters: false
  peoplePicker:
    users: false
    groups: false
    roles: false
  presets: false
  prompts: false
{% if NJ_FF_CODE_INTERPRETER_ENABLED === "true" %}
  runCode: true
{% else %}
  runCode: false
{% endif %}
  sidePanel: false
  webSearch: false
  mcpServers:
    use: true
    create: false
    share: false
    public: false
  remoteAgents:
    use: false
    create: false
    share: false
    public: false

endpoints:
  bedrock:
    availableRegions:
      - 'us-east-1'
    titleModel: current_model
    guardrailConfig:
      guardrailIdentifier: '${GUARDRAIL_ID}'
      guardrailVersion: '${GUARDRAIL_VERSION}'
      trace: 'enabled'
      streamProcessingMode: 'async' # streams responses faster, but may output inappropriate content before the scan completes

  agents:
    capabilities:
      - 'context'
      - 'ocr'
      - 'file_search'
      - 'chain'
{% if NJ_FF_CODE_INTERPRETER_ENABLED === "true" %}
      - 'execute_code'
{% endif %}

# We explicitly spec our models (since we only have a few models and this makes the selector simpler)
modelSpecs:
  list:
{% if NJ_FF_INCLUDE_SONNET_5 === "true" %}
    - name: claude-sonnet-5
      label: 'Claude Sonnet 5'
      default: true
      preset:
        endpoint: 'bedrock'
        model: 'us.anthropic.claude-sonnet-5'
{% endif %}
    - name: claude-sonnet-4-6
      label: 'Claude Sonnet 4.6'
      showInMenu: false
      preset:
        endpoint: 'bedrock'
        model: 'us.anthropic.claude-sonnet-4-6'
    - name: 'Claude Sonnet 4.5'
      label: 'Claude Sonnet 4.5'
{% if NJ_FF_INCLUDE_SONNET_5 !== "true" %}
      default: true
{% endif %}
      preset:
        endpoint: 'bedrock'
        model: 'us.anthropic.claude-sonnet-4-5-20250929-v1:0'

ocr:
  strategy: 'document_parser'

{% if NJ_FF_MEMORY_ENABLED === "true" %}
memory:
  tokenLimit: 2000
  agent:
    enabled: true
    provider: 'bedrock'
    model: 'us.anthropic.claude-sonnet-4-6'
{% endif %}

fileConfig:
  serverFileSizeLimit: 15 # Global multer limit (MB)
  endpoints:
    default:
      fileLimit: 10
      fileSizeLimit: 15 # mb
      totalSizeLimit: 60 # mb
